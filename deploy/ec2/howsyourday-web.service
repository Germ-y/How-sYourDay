[Unit]
Description=How's Your Day Web
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/howsyourday
Environment=NODE_ENV=production
Environment=PORT=4000
ExecStart=/usr/bin/npm --workspace apps/web run start -- -H 127.0.0.1 -p 4000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
